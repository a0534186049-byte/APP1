<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08101E"
    android:layoutDirection="rtl"
    android:padding="2dp">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_background_description"
        android:scaleType="centerCrop" />

    <FrameLayout
        android:id="@+id/widget_background_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#78040A16" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="2dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/app_name"
            android:textColor="#FFFFF2D7"
            android:typeface="serif"
            android:textStyle="bold"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:paddingBottom="1dp" />

        <LinearLayout
            android:id="@+id/widget_countdown_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:layoutDirection="rtl">

            <LinearLayout
                android:id="@+id/widget_cube_days"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/widget_cube_gold"
                android:padding="1dp">

                <TextView
                    android:id="@+id/widget_days_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00"
                    android:textColor="#FFFFE8B2"
                    android:typeface="serif"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="16sp" />

                <TextView
                    android:id="@+id/widget_days_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="ימים"
                    android:textColor="#FFFFE8B2"
                    android:typeface="serif"
                    android:textSize="8sp"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_cube_hours"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/widget_cube_gold"
                android:padding="1dp">

                <TextView
                    android:id="@+id/widget_hours_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00"
                    android:textColor="#FFFFE8B2"
                    android:typeface="serif"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_hours_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="שעות"
                    android:textColor="#FFFFE8B2"
                    android:typeface="serif"
                    android:textSize="8sp"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_cube_minutes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/widget_cube_gold"
                android:padding="1dp">

                <TextView
                    android:id="@+id/widget_minutes_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00"
                    android:textColor="#FFFFE8B2"
                    android:typeface="serif"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_minutes_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="דקות"
                    android:textColor="#FFFFE8B2"
                    android:typeface="serif"
                    android:textSize="8sp"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_cube_seconds"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/widget_cube_gold"
                android:padding="1dp">

                <TextView
                    android:id="@+id/widget_seconds_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00"
                    android:textColor="#FFFFE8B2"
                    android:typeface="serif"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_seconds_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="שניות"
                    android:textColor="#FFFFE8B2"
                    android:typeface="serif"
                    android:textSize="8sp"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_target_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFE8B2"
            android:typeface="serif"
            android:textSize="9sp"
            android:includeFontPadding="false"
            android:paddingTop="1dp"
            android:text="תאריך היעד" />
    </LinearLayout>
</FrameLayout>
